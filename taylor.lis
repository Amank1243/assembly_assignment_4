    22                                  ;
    23                                  ; Program Information:
    24                                  ; Name: Assignment 4 - Taylor Series
    25                                  ; Languages: C++, x86-64 Assembly, Bash
    26                                  ; Completion Date: 11/06/2026
    27                                  ;
    28                                  ; Program's Purpose:
    29                                  ; This program approximates e^x using a Taylor series consisting
    30                                  ; of n+1 terms. The calculation is performed in a reusable assembly
    31                                  ; library function.
    32                                  ;
    33                                  ; Project Information:
    34                                  ; Files: main.cpp, series.asm, taylor.asm, macro.inc, r.sh
    35                                  ; Status: Complete
    36                                  ;
    37                                  ; Execution:
    38                                  ; Run ./r.sh.
    39                                  ; The script assembles, compiles, links, and executes the program.
    40                                  ;
    41                                  ; File's Purpose:
    42                                  ; This file contains the taylor function, which receives a
    43                                  ; floating-point value x and an unsigned integer n, computes
    44                                  ; the sum of the Taylor series from k=0 through k=n, and
    45                                  ; returns the approximation as a 64-bit double.
    46                                  ;
    47                                  ; Function Prototype:
    48                                  ; double taylor(double x, unsigned long int n)
    49                                  ;
    50                                  ; Input:
    51                                  ; xmm0 = x (64-bit double)
    52                                  ; rdi  = n (unsigned long integer)
    53                                  ;
    54                                  ; Output:
    55                                  ; xmm0 = approximation of e^x (64-bit double)
    56                                  
    57                                  
    58                                  global taylor
    59                                  
    60                                  segment .data
    61                                  
    62 00000000 000000000000F03F            one dq 1.0
    63                                  
    64                                  segment .text
    65                                  
    66                                  taylor:
    67                                  
    68                                      ; Initialize the sum to 1.0
    69 00000000 F20F100C25-                 movsd xmm1, [one]
    69 00000005 [00000000]         
    70                                  
    71                                      ; Initialize the current term to 1.0
    72 00000009 F20F101425-                 movsd xmm2, [one]
    72 0000000E [00000000]         
    73                                  
    74                                      ; Start the loop counter at 1
    75 00000012 B901000000                  mov rcx, 1
    76                                  
    77                                  taylor_loop:
    78                                  
    79                                      ; Check whether n terms have been computed
    80 00000017 4839F9                      cmp rcx, rdi
    81 0000001A 7716                        ja taylor_done
    82                                  
    83                                      ; Multiply the current term by x
    84 0000001C F20F59D0                    mulsd xmm2, xmm0
    85                                  
    86                                      ; Convert the integer counter to a double
    87 00000020 F2480F2AD9                  cvtsi2sd xmm3, rcx
    88                                  
    89                                      ; Divide the current term by the counter
    90 00000025 F20F5ED3                    divsd xmm2, xmm3
    91                                  
    92                                      ; Add the new term to the running sum
    93 00000029 F20F58CA                    addsd xmm1, xmm2
    94                                  
    95                                      ; Increment the loop counter
    96 0000002D 48FFC1                      inc rcx
    97                                  
    98                                      ; Repeat the loop
    99 00000030 EBE5                        jmp taylor_loop
   100                                  
   101                                  taylor_done:
   102                                  
   103                                      ; Move the computed sum into xmm0
   104 00000032 F20F10C1                    movsd xmm0, xmm1
   105                                  
   106                                      ; Return to series.asm
   107 00000036 C3                          ret
