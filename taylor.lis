    21                                  ;
    22                                  ; Program Information:
    23                                  ; Name: Assignment 4 - Taylor Series
    24                                  ; Languages: C++, x86-64 Assembly, Bash
    25                                  ; Completion Date: 11/06/2026
    26                                  ;
    27                                  ; Program's Purpose:
    28                                  ; This program approximates e^x using a Taylor series consisting
    29                                  ; of n+1 terms. The calculation is performed in a reusable assembly
    30                                  ; library function.
    31                                  ;
    32                                  ; Project Information:
    33                                  ; Files: main.cpp, series.asm, taylor.asm, macro.inc, r.sh
    34                                  ; Status: Complete
    35                                  ;
    36                                  ; Execution:
    37                                  ; Run ./r.sh.
    38                                  ; The script assembles, compiles, links, and executes the program.
    39                                  ;
    40                                  ; File's Purpose:
    41                                  ; This file contains the taylor function, which receives a
    42                                  ; floating-point value x and an unsigned integer n, computes
    43                                  ; the sum of the Taylor series from k=0 through k=n, and
    44                                  ; returns the approximation as a 64-bit double.
    45                                  ;
    46                                  ; Function Prototype:
    47                                  ; double taylor(double x, unsigned long int n)
    48                                  ;
    49                                  ; Input:
    50                                  ; xmm0 = x (64-bit double)
    51                                  ; rdi  = n (unsigned long integer)
    52                                  ;
    53                                  ; Output:
    54                                  ; xmm0 = approximation of e^x (64-bit double)
    55                                  
    56                                  
    57                                  global taylor
    58                                  
    59                                  segment .data
    60                                  
    61 00000000 000000000000F03F        one dq 1.0
    62                                  
    63                                  segment .text
    64                                  
    65                                  taylor:
    66                                  
    67                                  ; Initialize the sum to 1.0
    68 00000000 F20F100C25-             movsd xmm1, [one]
    68 00000005 [00000000]         
    69                                  
    70                                  ; Initialize the current term to 1.0
    71 00000009 F20F101425-             movsd xmm2, [one]
    71 0000000E [00000000]         
    72                                  
    73                                  ; Start the loop counter at 1
    74 00000012 B901000000              mov rcx, 1
    75                                  
    76                                  taylor_loop:
    77                                  
    78                                  ; Check whether n terms have been computed
    79 00000017 4839F9                  cmp rcx, rdi
    80 0000001A 7716                    ja taylor_done
    81                                  
    82                                  ; Multiply the current term by x
    83 0000001C F20F59D0                mulsd xmm2, xmm0
    84                                  
    85                                  ; Convert the integer counter to a double
    86 00000020 F2480F2AD9              cvtsi2sd xmm3, rcx
    87                                  
    88                                  ; Divide the current term by the counter
    89 00000025 F20F5ED3                divsd xmm2, xmm3
    90                                  
    91                                  ; Add the new term to the running sum
    92 00000029 F20F58CA                addsd xmm1, xmm2
    93                                  
    94                                  ; Increment the loop counter
    95 0000002D 48FFC1                  inc rcx
    96                                  
    97                                  ; Repeat the loop
    98 00000030 EBE5                    jmp taylor_loop
    99                                  
   100                                  taylor_done:
   101                                  
   102                                  ; Move the computed sum into xmm0
   103 00000032 F20F10C1                movsd xmm0, xmm1
   104                                  
   105                                  ; Return to series.asm
   106 00000036 C3                      ret
