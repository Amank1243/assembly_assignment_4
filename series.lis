    63                              <1> ; Author Information:
    64                              <1> ; Name: Aman Khajuria
    65                              <1> ; CWID: 812144988
    66                              <1> ; Section(s): CPSC 240-#8, CPSC 240-#7
    67                              <1> ; Email: akhajuria@csu.fullerton.edu
    68                              <1> ;
    69                              <1> ; Program Information:
    70                              <1> ; Name: Assignment 3 - Non-deterministic Random Numbers
    71                              <1> ; Languages: C, C++, x86-64 Assembly, Bash
    72                              <1> ; Completion Date: 10/12/2026
    73                              <1> ;
    74                              <1> ; Program's Purpose:
    75                              <1> ; This program generates an array of random 64-bit IEEE 754 floating-point numbers.
    76                              <1> ; The program obtains the user's name, title, and requested array size, generates
    77                              <1> ; random values while rejecting NaN, and displays them in hexadecimal and scientific
    78                              <1> ; decimal formats. It then normalizes the values to the range 1.0 - 2.0, sorts
    79                              <1> ; them in ascending order, and displays the final results.
    80                              <1> ;
    81                              <1> ; Project Information:
    82                              <1> ; Files: main.c, executive.asm, fill_random_array.asm, is_nan.asm, show_array.asm,
    83                              <1> ;        normalize_array.asm, sort.cpp, macro.inc, r.sh
    84                              <1> ; Status: Complete
    85                              <1> ;
    86                              <1> ; Execution:
    87                              <1> ; Run ./r.sh.
    88                              <1> ; The script assembles, compiles, links, and executes the program.
    89                              <1> ;
    90                              <1> ; File's Purpose:
    91                              <1> ; This is a macro file that pushes and pops all registers before putting them to use.
    92                              <1> 
    93                              <1> 
    94                              <1> ; ------------------------------------------------------------
    95                              <1> ; Save the general-purpose registers before modifying them.
    96                              <1> ; ------------------------------------------------------------
    97                              <1> 
    98                              <1> %macro create_activation_record 0
    99                              <1> 
   100                              <1>     push rbp
   101                              <1>     mov rbp, rsp
   102                              <1> 
   103                              <1>     push rbx
   104                              <1>     push rcx
   105                              <1>     push rdx
   106                              <1>     push rdi
   107                              <1>     push rsi
   108                              <1>     push r8
   109                              <1>     push r9
   110                              <1>     push r10
   111                              <1>     push r11
   112                              <1>     push r12
   113                              <1>     push r13
   114                              <1>     push r14
   115                              <1>     push r15
   116                              <1>     pushf
   117                              <1> 
   118                              <1> %endmacro
   119                              <1> 
   120                              <1> 
   121                              <1> ; ------------------------------------------------------------
   122                              <1> ; Restore the saved registers before returning to the caller.
   123                              <1> ; ------------------------------------------------------------
   124                              <1> 
   125                              <1> %macro delete_activation_record 0
   126                              <1> 
   127                              <1>     popf
   128                              <1>     pop r15
   129                              <1>     pop r14
   130                              <1>     pop r13
   131                              <1>     pop r12
   132                              <1>     pop r11
   133                              <1>     pop r10
   134                              <1>     pop r9
   135                              <1>     pop r8
   136                              <1>     pop rsi
   137                              <1>     pop rdi
   138                              <1>     pop rdx
   139                              <1>     pop rcx
   140                              <1>     pop rbx
   141                              <1>     pop rbp
   142                              <1> 
   143                              <1> %endmacro
