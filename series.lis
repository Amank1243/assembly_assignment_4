    66                              <1> ; Email: akhajuria@csu.fullerton.edu
    67                              <1> ;
    68                              <1> ; Program Information:
    69                              <1> ; Name: Assignment 3 - Non-deterministic Random Numbers
    70                              <1> ; Languages: C, C++, x86-64 Assembly, Bash
    71                              <1> ; Completion Date: 10/12/2026
    72                              <1> ;
    73                              <1> ; Program's Purpose:
    74                              <1> ; This program generates an array of random 64-bit IEEE 754 floating-point numbers.
    75                              <1> ; The program obtains the user's name, title, and requested array size, generates
    76                              <1> ; random values while rejecting NaN, and displays them in hexadecimal and scientific
    77                              <1> ; decimal formats. It then normalizes the values to the range 1.0 - 2.0, sorts
    78                              <1> ; them in ascending order, and displays the final results.
    79                              <1> ;
    80                              <1> ; Project Information:
    81                              <1> ; Files: main.c, executive.asm, fill_random_array.asm, is_nan.asm, show_array.asm,
    82                              <1> ;        normalize_array.asm, sort.cpp, macro.inc, r.sh
    83                              <1> ; Status: Complete
    84                              <1> ;
    85                              <1> ; Execution:
    86                              <1> ; Run ./r.sh.
    87                              <1> ; The script assembles, compiles, links, and executes the program.
    88                              <1> ;
    89                              <1> ; File's Purpose:
    90                              <1> ; This is a macro file that pushes and pops all registers before putting them to use.
    91                              <1> 
    92                              <1> 
    93                              <1> ; ------------------------------------------------------------
    94                              <1> ; Save the general-purpose registers before modifying them.
    95                              <1> ; ------------------------------------------------------------
    96                              <1> 
    97                              <1> %macro create_activation_record 0
    98                              <1> 
    99                              <1>     push rbp
   100                              <1>     mov rbp, rsp
   101                              <1> 
   102                              <1>     push rbx
   103                              <1>     push rcx
   104                              <1>     push rdx
   105                              <1>     push rdi
   106                              <1>     push rsi
   107                              <1>     push r8
   108                              <1>     push r9
   109                              <1>     push r10
   110                              <1>     push r11
   111                              <1>     push r12
   112                              <1>     push r13
   113                              <1>     push r14
   114                              <1>     push r15
   115                              <1>     pushf
   116                              <1> 
   117                              <1> %endmacro
   118                              <1> 
   119                              <1> 
   120                              <1> ; ------------------------------------------------------------
   121                              <1> ; Restore the saved registers before returning to the caller.
   122                              <1> ; ------------------------------------------------------------
   123                              <1> 
   124                              <1> %macro delete_activation_record 0
   125                              <1> 
   126                              <1>     popf
   127                              <1>     pop r15
   128                              <1>     pop r14
   129                              <1>     pop r13
   130                              <1>     pop r12
   131                              <1>     pop r11
   132                              <1>     pop r10
   133                              <1>     pop r9
   134                              <1>     pop r8
   135                              <1>     pop rsi
   136                              <1>     pop rdi
   137                              <1>     pop rdx
   138                              <1>     pop rcx
   139                              <1>     pop rbx
   140                              <1>     pop rbp
   141                              <1> 
   142                              <1> %endmacro
